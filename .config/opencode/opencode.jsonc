{
  "$schema": "https://opencode.ai/config.json",
  "shell": "/usr/bin/fish",
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "--yes",
          "@playwright/mcp@0.0.83",
          "--browser=chromium",
          "--headless",
          "--isolated",
          "--caps=vision",
          "--idle-timeout=300000",
          "--no-webmcp"
        ],
        "timeout": 120000
      }
    }
  },
  "plugins": [
    "@dietrichgebert/ponytail@5.3.2"
  ]
}
